  18|
  19|                   Computation-Settings
  20|
  21|Material-Number = 7386       % Material number in FEOS parameter database
  22|Maxwell_Flag = 1             % "Maxwell construction" desired? (0: no, 1: yes)
  23|SoftSphere_Flag = 1          % Replace TF cold curve for densities < Rsolid with
  24|                             %   soft sphere function? (0: no, 1: yes)
  25|UserCalculations_Flag = 1    % Perform user-defined calculations? (0: no, 1: yes)
  26|
  27|%%%%%%%%%%%%%%%%%%%%%%%%
  28|
  29|                   Q-table
  30|
  31|% Distribution of densities:
  32|Rhonorm = 2.2     % Norm in g/cm^3
  33|Rhoratio-6 = 0    % Rhoratiox defines number of logarithmically distributed density
  34|Rhoratio-5 = 3    %   points in range Rnorm*1.0e(x-1) to Rnorm*1.0ex, x=-6...6
  35|Rhoratio-4 = 3    % Attention: Take care of lower density library limit
  36|Rhoratio-3 = 3
  37|Rhoratio-2 = 10
  38|Rhoratio-1 = 50
  39|Rhoratio0 = 50
  40|Rhoratio1 = 50
  41|Rhoratio2 = 10
  42|Rhoratio3 = 3
  43|Rhoratio4 = 3
  44|Rhoratio5 = 3
  45|Rhoratio6 = 3
  46|
  47|% Distribution of temperatures:
  48|Tnorm = 1.0e3     % Norm in eV
  49|Tratio-6 = 1      % Tratiox defines number of logarithmically distributed temperature
  50|Tratio-5 = 2      %   points in range Tnorm*1.0e(x-1) to Tnorm*1.0ex, x=-6...6
  51|Tratio-4 = 10     % Attention: Take care of lower temperature library limit
  52|Tratio-3 = 20
  53|Tratio-2 = 20
  54|Tratio-1 = 10
  55|Tratio0 = 2
  56|Tratio1 = 1
  57|Tratio2 = 1
  58|Tratio3 = 1
  59|Tratio4 = 0
  60|Tratio5 = 0
  61|Tratio6 = 0
  62|
  63|
  64|%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  65|%% EOS table visualization (showeos):
  66|%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  67|
  68|                   General
  69|
  70|File-Format = 1    % 1: FEOS (recommended), 2: SESAME 301/304/305
  71|EOS-Type = 1       % 1: total, 2: electronic, 3: ionic, 4: Thomas-Fermi
  72|
  73|% FEOS format: Implies .feos file.
  74|%   All thermodynamic quantities are available!
  75|% SESAME format: Implies .301 (total), .304 (electrons), or .305 (ions) file.
  76|%   Thomas-Fermi EOS and charge state are not available!
  77|
  78|%%%%%%%%%%%%%%%%%%%%%%%
  79|
  80|                   Units
  81|
  82|Rho_unit = 1.0     % 1.0 ---> g/cm^3
  83|T_unit = 1.0       % 1.0 ---> eV, 8.617525902e-5 ---> K
  84|P_unit = 1.0e12    % 1.0 ---> dyne/cm^2, 1.0e12 ---> MBar
  85|E_unit = 1.0       % 1.0 ---> erg/g, 1.0e10 ---> MJ/kg
  86|U_unit = 1.0e5     % 1.0 ---> cm/s, 1.0e5 ---> km/s
  87|
  88|% The following units are set automatically:
  89|%   F_unit = E_unit, S_unit = E_unit / T_unit,
  90|%   V_unit = 1.0 / Rho_unit, Q_unit = 1.0
  91|
  92|%%%%%%%%%%%%%%%%%%%%%%%
  93|
  94|                   Rho-T-Mesh
  95|
  96|% Distribution of densities:
  97|Rhomin = 1.0e-3    % Minimum density (in units which are defined above)
  98|Rhomax = 10        % Maximum density (in units which are defined above)
  99|Rhooriginal = 0    % Use only original tabulated densities? (0: no, 1: yes)
 100|Rhonumber = 5      % Number of densities (if Rhooriginal is set to 0)
 101|Rholog = 0         % 0: linearly distributed, 1: logarithmically distributed
 102|
 103|% Distribution of temperatures (for isentropes only at Rhomin):
 104|Tmin = 1.0e-4    % Minimum temperature (in units which are defined above)
 105|Tmax = 1.0e3     % Maximum temperature (in units which are defined above)
 106|Toriginal = 0    % Use only original tabulated temperatures? (0: no, 1: yes)
 107|Tnumber = 7      % Number of temperatures (if Toriginal is set to 0)
 108|Tlog = 1         % 0: linearly distributed, 1: logarithmically distributed
 109|
 110|% Only for isotherms, isochores, or Mountain plots:
 111|Rhofirst = 0     % Print out lowest density of table? (0: no, 1: yes)
 112|Tfirst = 1       % Print out lowest temperature of table? (0: no, 1: yes)
 113|
 114|% For isentropes, the entropies are initialized at (Rho=Rhomin, T=Tmin,...,Tmax).
 115|% => Number of isentropes = Number of temperatures
 116|% For isentropes, the maximum and minimum temperatures for Rho > Rhomin are given
 117|%   by the table boundaries, not by Tmin and Tmax.
 118|
 119|%%%%%%%%%%%%%%%%%%%%%%%
 120|
 121|                   Isocurves
 122|
 123|% Output settings for isotherms, isochores, and isentropes:
 124|Xquantity = 1    % Quantity which is printed out on the x-axis
