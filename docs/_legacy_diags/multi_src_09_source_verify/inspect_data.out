 126|Yquantity = 4    % Quantity which is printed out on the y-axis
 127|Yelement = 0     % Element number (only for charge state of mixtures, 0: sum)
 128|
 129|% Possible choices for Xquantity and Yquantity:
 130|%   1: density, 2: specific volume, 3: temperature, 4: pressure,
 131|%   5: specific internal energy, 6: specific Helmholtz free energy,
 132|%   7: specific entropy, 8: summed-up or single-element charge state
 133|
 134|%%%%%%%%%%%%%%%%%%%%%%%
 135|
 136|                   Mountain
 137|
 138|% Quantity printed out as function of density / specific volume and temperature:
 139|Xquantity = 1    % 1: density, 2: specific volume
 140|Quantity = 4     % Mountain quantity as function of Xquantity and temperature
 141|Element = 0      % Element number (only for charge state of mixtures, 0: sum)
 142|
 143|% Possible choices for Quantity:
 144|%   4: pressure, 5: specific internal energy, 6: specific Helmholtz free energy,
 145|%   7: specific entropy, 8: summed-up or single-element charge state
 146|
 147|%%%%%%%%%%%%%%%%%%%%%%%
 148|
 149|                   Hugoniot
 150|
