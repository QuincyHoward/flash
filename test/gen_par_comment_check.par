sim_rhoTarg = 1                                                              # targ initial density [g/cm3]
sim_teleTarg = 290.11375                                                     # targ initial electron temperature [K]
sim_tionTarg = 290.11375                                                     # targ initial ion temperature [K]
sim_tradTarg = 290.11375                                                     # targ initial radiation temperature [K]
