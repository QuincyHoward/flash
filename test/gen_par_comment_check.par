rt_mgdFlMode = "fl_harmonic"
rt_mgdFlCoef = 1
rt_mgdXlBoundaryType = "vacuum"
rt_mgdXrBoundaryType = "vacuum"
op_chamAbsorb = "op_tabpa"                                                   # cham opacity absorption mode
op_chamEmiss = "op_tabpe"                                                    # cham opacity emission mode
op_chamTrans = "op_tabro"                                                    # cham opacity transmission mode
op_chamFileType = "ionmix4"                                                  # cham opacity opacity file type
op_chamFileName = "He-BADGER-TOPS-Final.cn4"                                 # cham opacity opacity table file
op_targAbsorb = "op_tabpa"                                                   # targ opacity absorption mode
op_targEmiss = "op_tabpe"                                                    # targ opacity emission mode
op_targTrans = "op_tabro"                                                    # targ opacity transmission mode
op_targFileType = "ionmix4"                                                  # targ opacity opacity file type
op_targFileName = "CH-QC-1-001.cn4"                                          # targ opacity opacity table file
op_sampAbsorb = "op_tabpa"                                                   # samp opacity absorption mode
op_sampEmiss = "op_tabpe"                                                    # samp opacity emission mode
op_sampTrans = "op_tabro"                                                    # samp opacity transmission mode
op_sampFileType = "ionmix4"                                                  # samp opacity opacity file type
op_sampFileName = "CH-QC-1-001.cn4"                                          # samp opacity opacity table file
op_shldAbsorb = "op_tabpa"                                                   # shld opacity absorption mode
op_shldEmiss = "op_tabpe"                                                    # shld opacity emission mode
op_shldTrans = "op_tabro"                                                    # shld opacity transmission mode
op_shldFileType = "ionmix4"                                                  # shld opacity opacity file type
op_shldFileName = "CH-QC-1-001.cn4"                                          # shld opacity opacity table file
rt_dtFactor = 1.000000000000000e+100

