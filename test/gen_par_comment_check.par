xmin = -0.04                                                                 # domain left edge [cm]
xmax = 0.01                                                                  # domain right edge [cm]
nblockx = 8                                                                  # number of blocks along x
lrefine_max = 9                                                              # res = dir_delta/(nxb*nblock*2^(lrefine_max-1)) = 1.525879e-06 cm
lrefine_min = 1                                                              # res = dir_delta/(nxb*nblock*2^(lrefine_min-1)) = 3.906250e-04 cm
