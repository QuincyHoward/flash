run_comment = "LaserSlab 1D Simulation - Generated by ParGeneratorExtended"  # run description
log_file    = "lasslab.log"                                                  # runtime log file name
basenm      = "lasslab_"                                                     # basename for all output files


##########################
#                        #
#     I/O PARAMETERS            #
#                        #
##########################

checkpointFileIntervalTime = 1                                               # checkpoint interval [s]
checkpointFileIntervalStep = 400                                             # checkpoint interval [steps]
plotFileNumber = 0                                                           # first plotfile number
plotFileIntervalStep = 2000                                                  # plotfile interval [steps]
plot_var_1 = "dens"                                                          # plotfile output variable whitelist #1
plot_var_2 = "depo"                                                          # plotfile output variable whitelist #2
plot_var_3 = "tele"                                                          # plotfile output variable whitelist #3
plot_var_4 = "tion"                                                          # plotfile output variable whitelist #4
plot_var_5 = "trad"                                                          # plotfile output variable whitelist #5
plot_var_6 = "ye  "                                                          # plotfile output variable whitelist #6
plot_var_7 = "sumy"                                                          # plotfile output variable whitelist #7
plot_var_8 = "cham"                                                          # plotfile output variable whitelist #8
plot_var_9 = "targ"                                                          # plotfile output variable whitelist #9
plot_var_10 = "shld"                                                         # plotfile output variable whitelist #10
plot_var_11 = "samp"                                                         # plotfile output variable whitelist #11
plot_var_12 = "fllm"                                                         # plotfile output variable whitelist #12
restart = .false.                                                            # restart from checkpoint?
checkpointFileNumber = 0                                                     # first checkpoint file number

##########################
#                        #
#     RADIATION/OPACITY PARAMETERS#
#                        #
##########################

rt_useMGD = .true.                                                           # enable multi-group diffusion
rt_mgdNumGroups = 10                                                         # number of MDS radiation groups
rt_mgdBounds_1 = 0.1                                                         # MGD radiation group boundary 1
rt_mgdBounds_2 = 0.3981072                                                   # MGD radiation group boundary 2
