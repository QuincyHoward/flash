ms_shldZ = 3.5                                                               # Z-related: atomic number (shld)
ms_shldZMin = 1.000000000000000e-23
sim_rhoSamp = 1                                                              # samp initial density [g/cm3]
sim_teleSamp = 290.11375                                                     # samp initial electron temperature [K]
sim_tionSamp = 290.11375                                                     # samp initial ion temperature [K]
sim_tradSamp = 290.11375                                                     # samp initial radiation temperature [K]
