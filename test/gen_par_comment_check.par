sim_rhoCham = 1.000000000000000e-06                                          # cham initial density [g/cm3]
sim_teleCham = 290.11375                                                     # cham initial electron temperature [K]
sim_tionCham = 290.11375                                                     # cham initial ion temperature [K]
sim_tradCham = 290.11375                                                     # cham initial radiation temperature [K]
ms_chamA = 4.002602                                                          # A-related: atomic weight (cham)
ms_chamZ = 2                                                                 # Z-related: atomic number (cham)
sim_rhoShld = 1                                                              # shld initial density [g/cm3]
sim_teleShld = 290.11375                                                     # shld initial electron temperature [K]
sim_tionShld = 290.11375                                                     # shld initial ion temperature [K]
sim_tradShld = 290.11375                                                     # shld initial radiation temperature [K]
