#################################
#                               #
#     CONDUCTION PARAMETERS     #
#                               #
#################################
useConductivity = .true.
diff_useEleCond = .true.
useDiffuse      = .true.

diff_eleFlMode = "fl_minmax"  # 限流模式
diff_eleFlCoef = 0.08  # 限流因子
diff_thetaImplct = 1.0

diff_eleXlBoundaryType = "neumann"
diff_eleXrBoundaryType = "neumann"


####################################
#                                  #
#     HEAT EXCHANGE PARAMETERS     #
#                                  #
####################################
useHeatexchange = .true.


##########################
#                        #
#     EOS PARAMETERS     #
#                        #
##########################
eosModeInit      = "dens_temp_gather"
smallt           = 1.0
smallx           = 1.0e-99
eos_useLogTables = .false.


############################
#                          #
#     HYDRO PARAMETERS     #
#                          #
############################
useHydro = .true.
 
order            = 3        # Interpolation order (first/second/third/fifth order)
slopeLimiter     = "minmod" # Slope limiters (minmod, mc, vanLeer, hybrid, limited)
LimitedSlopeBeta = 1.       # Slope parameter for the "limited" slope by Toro
charLimiting     = .true.   # Characteristic limiting vs. Primitive limiting
use_avisc        = .true.   # use artificial viscosity (originally for PPM)
cvisc            = 0.1      # coefficient for artificial viscosity
use_flattening   = .false.  # use flattening (dissipative) (originally for PPM)
use_steepening   = .false.  # use contact steepening (originally for PPM)
use_upwindTVD    = .false.  # use upwind biased TVD slope for PPM (need nguard=6)
RiemannSolver    = "hllc"   # Roe, HLL, HLLC, LLF, Marquina, hybrid
entropy          = .false.  # Entropy fix for the Roe solver
shockDetect = .true.  # more??
use_hybridOrder  = .true.   # Enforce Riemann density jump

# Hydro boundary conditions:
xl_boundary_type = "outflow"
xr_boundary_type = "outflow"


##############################
#                            #
#     INITIAL CONDITIONS     #
#                            #
##############################

sim_targetHeight = 0.000000000e+00  # 靶高度
sim_shldRadius = 0.1e-04
sim_sampRadius = 2.000000000e-04  # 材料更换
sim_targetRadius = 1.000000000e-05  # Ti厚度
sim_sampHeight = 5.000000000e-03  # 材料更换


# Chamber material defaults set for Helium at pressure 1.6 mbar:
sim_rhoCham  = 1.0e-06
sim_teleCham = 290.11375
sim_tionCham = 290.11375
sim_tradCham = 290.11375
ms_chamA = 4.002602
ms_chamZ = 2.0
eos_chamEosType = "eos_tab"
eos_chamSubType = "ionmix4"
eos_chamTableFile = "He-BADGER-TOPS-Final.cn4"



# XXX material defaults set for XXX at room temperature:
sim_rhoShld  = 6.11
sim_teleShld = 290.11375
sim_tionShld = 290.11375
sim_tradShld = 290.11375
ms_shldA = 50.9415
ms_shldZ = 23
ms_shldZMin = 1e-23
eos_shldEosType = "eos_tab"
eos_shldSubType = "ionmix4"
eos_shldTableFile = "V-BADGER-TOPS.cn4"


# XXX material defaults set for XXX at room temperature:
#sim_rhoSamp  = 19.32
#sim_teleSamp = 290.11375
#sim_tionSamp = 290.11375
#sim_tradSamp = 290.11375
#ms_sampA = 196.966569
#ms_sampZ = 79
#ms_sampZMin = 1e-23
#eos_sampEosType = "eos_tab"
#eos_sampSubType = "ionmix4"
#eos_sampTableFile = "Au-imx.cn4"


# XXX material defaults set for XXX at room temperature:
sim_rhoSamp = 1.0  # 材料更换
sim_teleSamp = 290.11375
sim_tionSamp = 290.11375
sim_tradSamp = 290.11375
ms_sampA = 6.509  # 材料更换
ms_sampZ = 3.5  # 材料更换
ms_sampZMin = 1e-23
eos_sampEosType = "eos_tab"
eos_sampSubType = "ionmix4"
eos_sampTableFile = "CH-QC-1-001.cn4"  # 材料更换



# Target material defaults set for XXX at room temperature:
sim_rhoTarg  = 4.54
sim_teleTarg = 290.11375
sim_tionTarg = 290.11375
sim_tradTarg = 290.11375
ms_targA = 47.867
ms_targZ = 22
ms_targZMin = 1e-23
eos_targEosType = "eos_tab"
eos_targSubType = "ionmix4"
eos_targTableFile = "Ti-BADGER-TOPS.cn4"

###########################
#                         #
#     TIME PARAMETERS     #
#                         #
###########################
tstep_change_factor = 1.10
cfl            = 0.4
dt_diff_factor = 1.0e+100 # Disable diffusion dt
rt_dtFactor    = 1.0e+100 # 原始设置的是0.02
hx_dtFactor    = 1.0e+100
tmax = 1.600000000e-09  # 生成的参数
dtmin = 1.000000000e-16  # 生成的参数
dtinit = 1.000000000e-15  # 生成的参数
dtmax = 1.650000000e-09  # 生成的参数
nend           = 100000000


###########################
#                         #
#     MESH PARAMETERS     #
#                         #
###########################
geometry = "cartesian"

# Domain size:
xmin = -2.500000000e-02  # X左边界
xmax = 7.500000000e-03  # X右边界

# Total number of blocks:
nblockx = 8  # 生成的参数

lrefine_max = 8  # X_res_min=1.984e-06,
lrefine_min = 1  # X_res_max=2.539e-04,
refine_var_1 = "dens"
refine_var_2 = "tele"
