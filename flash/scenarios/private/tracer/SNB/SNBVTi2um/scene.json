{
  "name": "SNBVTi2um",
  "kind": "script",
  "aliases": [
    "snbvti2um"
  ],
  "description": "SNB 非局域热传导 VTi 示踪（2 µm Ti 层；仅超算，125 进程=网格定义；本地生成+SFTP 上传）",
  "policy": "snb",
  "script": "flash/scenarios/private/tracer/SNB/SNBVTi2um/SNBVTi2um.py",
  "sim_name": "SNBVTi2um",
  "nproc_default": 125,
  "hpc": {
    "input_rel_dir": "flash/scenarios/private/tracer/SNB/SNBVTi2um/flash_input",
    "gen_script": "flash/scenarios/private/tracer/SNB/SNBVTi2um/SNBVTi2um.py",
    "flash_unit": "SNBVTi2um",
    "par_file": "snbvti2um.par",
    "setup_extra": [],
    "ntasks": 125,
    "time_limit": "01:00:00",
    "setup_common": [
      "-1d",
      "+cartesian",
      "+ug",
      "-nxb=200",
      "+hdf5typeio",
      "species=cham,shld,samp,tar1,tar2,tar3,tar4,tar6",
      "+mtmmmt",
      "+laser",
      "+uhd3t",
      "+mgd",
      "mgd_meshgroups=10",
      "ed_maxPulseSections=300"
    ],
    "flash_home_default": "$HOME/QC/FLASH/FLASHSNB/FLASH4.8",
    "launcher": "mpiexec",
    "nodes": 3,
    "archive_patterns": [
      "snbvti2umug_*"
    ],
    "gen_mode": "local_upload",
    "gen_args": [
      "--generate-only"
    ],
    "pre_build_targets": [
      "hy_slopeLimiters.o",
      "Conductivity_interface.o",
      "Conductivity_fullState.o"
    ],
    "make_jobs_max": 16,
    "env_profile": "flash_home_hdf5"
  }
}
