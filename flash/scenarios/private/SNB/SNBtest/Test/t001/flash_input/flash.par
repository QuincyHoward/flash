#eos_tar1SubType = "ionmix4"
#eos_targTableFile = "al-imx-003.cn4"
#eos_tar1TableFile = "CH-BADGER-TOPS-Final.cn4"

sim_rhoTar1  = 1.04
sim_teleTar1 = 290.11375
sim_tionTar1 = 290.11375
sim_tradTar1 = 290.11375
ms_tar1A = 6.5
ms_tar1Z = 3.5
ms_tar1ZMin = 0.02
eos_tar1EosType = "eos_tab"
eos_tar1SubType = "ionmix4"
#eos_targTableFile = "al-imx-003.cn4"
eos_tar1TableFile = "CH-BADGER-TOPS-Final.cn4"

sim_rhoTar2  = 1.04
sim_teleTar2 = 290.11375
sim_tionTar2 = 290.11375
sim_tradTar2 = 290.11375
ms_tar2A = 6.5
ms_tar2Z = 3.5
ms_tar2ZMin = 0.02
eos_tar2EosType = "eos_tab"
eos_tar2SubType = "ionmix4"
#eos_targTableFile = "al-imx-003.cn4"
eos_tar2TableFile = "CH-BADGER-TOPS-Final.cn4"

sim_rhoTar3  = 1.04
sim_teleTar3 = 290.11375
sim_tionTar3 = 290.11375
sim_tradTar3 = 290.11375
ms_tar3A = 6.5
ms_tar3Z = 3.5
ms_tar3ZMin = 0.02
eos_tar3EosType = "eos_tab"
eos_tar3SubType = "ionmix4"
#eos_targTableFile = "al-imx-003.cn4"
eos_tar3TableFile = "CH-BADGER-TOPS-Final.cn4"


# Chamber material defaults set for Helium at pressure 1.6 mbar:
sim_rhoCham  = 1.0e-6
sim_teleCham = 290.11375
sim_tionCham = 290.11375
sim_tradCham = 290.11375
ms_chamA = 4.002602
ms_chamZ = 2.0
eos_chamEosType = "eos_tab"
eos_chamSubType = "ionmix4"
#eos_chamTableFile = "he-imx-005.cn4"
eos_chamTableFile = "He-BADGER-TOPS-Final.cn4"

###########################
#                         #
#     TIME PARAMETERS     #
#                         #
###########################
tstep_change_factor = 1.10
cfl            = 0.2
dt_diff_factor = 1.0e+100 # Disable diffusion dt
rt_dtFactor    = 1.0e+100
hx_dtFactor    = 1.0e+100
tmax           = 1.0e-11
dtmin          = 1.0e-16
dtinit         = 1.0e-15
dtmax          = 2.0e-12
nend           = 10000000


###########################
#                         #
#     MESH PARAMETERS     #
#                         #
###########################
geometry = "cartesian"

# Domain size:
xmin = -50e-4
xmax = 250e-4

#gr_hypreSolverType = "HYPRE_PCG"
#gr_hyprePcType =  "HYPRE_ILU"
#gr_hypreMaxIter = 5000
#gr_hypreRelTol = 1.0e-8
gr_hypreUseFloor = .false.
# Total number of blocks:
nblockx = 5

lrefine_max = 6
lrefine_min = 6
lrefine_min_init = 6
refine_var_1 = "dens"
refine_var_2 = "tele"

iProcs = 4
#jProcs = 4
#kProcs = 1
