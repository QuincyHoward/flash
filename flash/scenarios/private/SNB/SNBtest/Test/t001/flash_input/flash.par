#ed_gaussianRadiusMajor_1      =  60e-04
#ed_gaussianRadiusMinor_1      =  60e-04
ed_numberOfRays_1             =  1
ed_gridType_1                 = "regular1D"
ed_gridnRadialTics_1          =  512
