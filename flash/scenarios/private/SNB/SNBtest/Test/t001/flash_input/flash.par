run_comment = "NonLTConduct Simulation"
log_file    = "NonLTConduct.log"
basenm      = "NonLTConduct_2D_"
############ unit system ###########

UnitSystem  = "CGS"
pc_unitsBase  = "CGS"

# This particular parfile is used as an example of
# SG3 prototype experiment in 2020.11

##########################
#                        #
#     I/O PARAMETERS     #
#                        #
##########################

### Checkpoint Options  ###
#checkpointFileIntervalTime = 1e-11
#checkpointFileIntervalStep = 1000

### Plot Options ###
#plotFileIntervalStep = 1
plotFileIntervalTime = 1e-11
plot_var_1           = "dens" # dens*ye*6.02e23
plot_var_2           = "depo"
plot_var_3           = "tele"
plot_var_4           = "tion"
plot_var_5           = "QESH"
plot_var_6           = "QESX"
plot_var_7           = "QESY"
plot_var_8           = "GRQX"
plot_var_9           = "GRAQ"
plot_var_10          = "CORQ"
plot_var_11          = "MFPE"
plot_var_12          = "ye"
plot_var_13          = "tar1"
plot_var_14          = "tar2"
plot_var_15          = "tar3"
#plot_var_16          = "velx"
#plot_var_17          = "vely"
#plot_var_18          = "velz"

### Restart Options ###
restart              = .false.
checkpointFileNumber = 0

########################################
#                                      #
#     RADIATION/OPACITY PARAMETERS     #
#                                      #
########################################
rt_useMGD       = .true.# Multi-Group Diffusion
rt_mgdNumGroups = 10
rt_mgdBounds_1  = 1.0e-01
rt_mgdBounds_2  = 3.981e-01
rt_mgdBounds_3  = 1.585e+00
rt_mgdBounds_4  = 6.31e+00
rt_mgdBounds_5  = 2.51e+01
rt_mgdBounds_6  = 1.0e+02
rt_mgdBounds_7  = 3.981e+02
rt_mgdBounds_8  = 1.585e+03
rt_mgdBounds_9  = 6.31e+03
rt_mgdBounds_10 = 2.51e+04
rt_mgdBounds_11 = 1.0e+05
op_tableEnergyTolerance = 1e-2

##### parameters can modifies Radiation Diffuse, coef is the ratio to FS. ##### 

rt_mgdFlMode    = "fl_larsen"
rt_mgdFlCoef    = 1.0

rt_mgdXlBoundaryType = "vacuum"
rt_mgdXrBoundaryType = "vacuum"
rt_mgdYlBoundaryType = "vacuum"
rt_mgdYrBoundaryType = "vacuum"
rt_mgdZlBoundaryType = "vacuum"
rt_mgdZrBoundaryType = "vacuum"

##### opacity #####

useOpacity     = .true.

### SET CHAMBER (HELIUM) OPACITY OPTIONS ###
op_chamAbsorb   = "op_tabpa"
op_chamEmiss    = "op_tabpe"
op_chamTrans    = "op_tabro"
op_chamFileType = "ionmix4"
#op_chamFileName = "he-imx-005.cn4"
op_chamFileName = "He-BADGER-TOPS-Final.cn4"

### SET TARGET (ALUMINUM) OPACITY OPTIONS ###
op_tar1Absorb   = "op_tabpa"
op_tar1Emiss    = "op_tabpe"
op_tar1Trans    = "op_tabro"
op_tar1FileType = "ionmix4"
#op_targFileName = "al-imx-003.cn4"
op_tar1FileName = "CH-BADGER-TOPS-Final.cn4"

### SET TARGET (ALUMINUM) OPACITY OPTIONS ###
op_tar2Absorb   = "op_tabpa"
op_tar2Emiss    = "op_tabpe"
op_tar2Trans    = "op_tabro"
op_tar2FileType = "ionmix4"
#op_targFileName = "al-imx-003.cn4"
op_tar2FileName = "CH-BADGER-TOPS-Final.cn4"

### SET TARGET (ALUMINUM) OPACITY OPTIONS ###
op_tar3Absorb   = "op_tabpa"
op_tar3Emiss    = "op_tabpe"
op_tar3Trans    = "op_tabro"
op_tar3FileType = "ionmix4"
#op_targFileName = "al-imx-003.cn4"
op_tar3FileName = "CH-BADGER-TOPS-Final.cn4"


############################
#                          #
#     LASER PARAMETERS     #
#                          #
############################
useEnergyDeposition = .true.
ed_maxRayCount      = 10000
ed_gradOrder        = 2

# Activate 3D-in-2D ray trace:
#ed_laser3Din2D           = .true.
#ed_laser3Din2DwedgeAngle = 0.1


### LASER IO OPTIONS ###
ed_useLaserIO                  = .true.
ed_laserIOMaxNumberOfPositions = 10000
ed_laserIOMaxNumberOfRays      = 64

### SETUP LASER PULSES ###
ed_numberOfPulses = 1

# Define Pulse 1:
ed_numberOfSections_1 = 4
ed_time_1_1  = 0.0
ed_time_1_2  = 0.2e-09
ed_time_1_3  = 0.99e-09
ed_time_1_4  = 1.0e-09

ed_power_1_1 = 0.0
ed_power_1_2 = 1.5e+14
ed_power_1_3 = 1.5e+14
ed_power_1_4 = 0.0

### SETUP LASER BEAM ###
ed_numberOfBeams = 1


# Setup Gaussian Beam:
ed_lensX_1                    =  500.0e-04
#ed_lensY_1                    =  0.0e-04
