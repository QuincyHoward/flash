eos_polyEosType                = eos_tab
eos_polySubType                = ionmix4
eos_polyTableFile              = Z06_0.50-Z01_0.50-20260708_0850.cn4

##############################
#  HYDRO PARAMETERS
##############################

useHydro                       = .true.
order                          = 3
