plotFileNumber                 = 0
restart                        = .false.
checkpointFileNumber           = 0
plot_var_1                     = dens
plot_var_2                     = depo
plot_var_3                     = tele
plot_var_4                     = tion
plot_var_5                     = trad
plot_var_6                     = ye  
plot_var_7                     = sumy
plot_var_8                     = cham
plot_var_9                     = targ
plot_var_10                    = poly

##############################
#  RADIATION/OPACITY PARAMETERS
##############################

op_chamAbsorb                  = op_tabpa
op_chamEmiss                   = op_tabpe
